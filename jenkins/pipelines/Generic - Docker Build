pipeline {

    agent any

    stages {

        stage('Notify Start') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'teams-webhook',
                        variable: 'TEAMS_WEBHOOK_URL'
                    )
                ]) {
                    office365ConnectorSend(
                        webhookUrl: TEAMS_WEBHOOK_URL,
                        message: """
🟡 Docker Build Started

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Branch: ${params.GIT_BRANCH}
Build: #${env.BUILD_NUMBER}
""",
                        status: 'Started',
                        adaptiveCards: true
                    )
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[
                        name: "*/${params.GIT_BRANCH}"
                    ]],
                    userRemoteConfigs: [[
                        credentialsId: 'jenkins-master',
                        url: params.GIT_REPO
                    ]]
                ])
            }
        }

        stage('Prepare') {
            steps {
                script {

                    env.COMMIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.ENV_FILE = "/var/lib/jenkins/devops-lab/applications/${params.APP_NAME}/${params.ENVIRONMENT}.env"

                    env.IMAGE_TAG = "${env.COMMIT_SHA}-${params.ENVIRONMENT}"

                    echo "===== Build Information ====="
                    echo "Repository:       ${params.GIT_REPO}"
                    echo "Branch:           ${params.GIT_BRANCH}"
                    echo "Commit:           ${env.COMMIT_SHA}"
                    echo "Application:      ${params.APP_NAME}"
                    echo "Environment:      ${params.ENVIRONMENT}"
                    echo "Image:            ${params.IMAGE_NAME}:${env.IMAGE_TAG}"
                    echo "Environment file: ${env.ENV_FILE}"
                    echo "Deploy Job:       ${params.DEPLOY_JOB}"

                    if (fileExists(env.ENV_FILE)) {
                        env.HAS_ENV_FILE = 'true'
                        echo "Environment file found."
                    } else {
                        env.HAS_ENV_FILE = 'false'
                        echo "No environment file found. Continuing without .env."
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh """
                    set -eu

                    if [ "${env.HAS_ENV_FILE}" = "true" ]; then
                        echo "===== Creating .env ====="
                        cp '${env.ENV_FILE}' .env
                    else
                        echo "===== No .env required ====="
                    fi

                    echo "===== Docker Version ====="
                    docker --version

                    echo "===== Building Docker Image ====="
                    echo "Image: ${params.IMAGE_NAME}:${env.IMAGE_TAG}"

                    docker build \\
                        -t '${params.IMAGE_NAME}:${env.IMAGE_TAG}' \\
                        .

                    echo "===== Removing .env ====="
                    rm -f .env
                """
            }
        }

        stage('Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh """
                        set -eu

                        echo "===== Logging in to Docker Hub ====="

                        set +x
                        echo "\${DOCKER_PASSWORD}" | docker login \\
                            --username "\${DOCKER_USERNAME}" \\
                            --password-stdin
                        set -x

                        echo "===== Pushing Docker Image ====="
                        echo "Image: ${params.IMAGE_NAME}:${env.IMAGE_TAG}"

                        docker push '${params.IMAGE_NAME}:${env.IMAGE_TAG}'

                        echo "===== Logging out of Docker Hub ====="
                        docker logout
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                script {

                    echo "===== Triggering Deployment ====="
                    echo "Deploy Job: ${params.DEPLOY_JOB}"
                    echo "Image: ${params.IMAGE_NAME}:${env.IMAGE_TAG}"

                    build(
                        job: params.DEPLOY_JOB,
                        parameters: [
                            string(
                                name: 'APP_NAME',
                                value: params.APP_NAME
                            ),
                            string(
                                name: 'ENVIRONMENT',
                                value: params.ENVIRONMENT
                            ),
                            string(
                                name: 'IMAGE_NAME',
                                value: params.IMAGE_NAME
                            ),
                            string(
                                name: 'IMAGE_TAG',
                                value: env.IMAGE_TAG
                            )
                        ],
                        wait: true
                    )
                }
            }
        }
    }

    post {

        success {
            withCredentials([
                string(
                    credentialsId: 'teams-webhook',
                    variable: 'TEAMS_WEBHOOK_URL'
                )
            ]) {
                office365ConnectorSend(
                    webhookUrl: TEAMS_WEBHOOK_URL,
                    message: """
🟢 Docker Build Successful

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Branch: ${params.GIT_BRANCH}
Commit: ${env.COMMIT_SHA}
Image: ${params.IMAGE_NAME}:${env.IMAGE_TAG}
Build: #${env.BUILD_NUMBER}
""",
                    status: 'Success',
                    adaptiveCards: true
                )
            }
        }

        failure {
            withCredentials([
                string(
                    credentialsId: 'teams-webhook',
                    variable: 'TEAMS_WEBHOOK_URL'
                )
            ]) {
                office365ConnectorSend(
                    webhookUrl: TEAMS_WEBHOOK_URL,
                    message: """
🔴 Docker Build Failed

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Branch: ${params.GIT_BRANCH}
Commit: ${env.COMMIT_SHA ?: 'Not available'}
Build: #${env.BUILD_NUMBER}
""",
                    status: 'Failure',
                    adaptiveCards: true
                )
            }
        }

        aborted {
            withCredentials([
                string(
                    credentialsId: 'teams-webhook',
                    variable: 'TEAMS_WEBHOOK_URL'
                )
            ]) {
                office365ConnectorSend(
                    webhookUrl: TEAMS_WEBHOOK_URL,
                    message: """
⚪ Docker Build Aborted

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Branch: ${params.GIT_BRANCH}
Build: #${env.BUILD_NUMBER}
""",
                    status: 'Aborted',
                    adaptiveCards: true
                )
            }
        }

        always {
            sh '''
                echo "===== Cleaning Up ====="
                rm -f .env
            '''
        }
    }
}