pipeline {

    agent any

    stages {

        stage('Validate Parameters') {
            steps {
                script {
                    echo "===== Deployment Information ====="
                    echo "Application: ${params.APP_NAME}"
                    echo "Environment: ${params.ENVIRONMENT}"
                    echo "Image:       ${params.IMAGE_NAME}:${params.IMAGE_TAG}"

                    if (!params.APP_NAME?.trim()) {
                        error 'APP_NAME is required'
                    }

                    if (!params.ENVIRONMENT?.trim()) {
                        error 'ENVIRONMENT is required'
                    }

                    if (!params.IMAGE_NAME?.trim()) {
                        error 'IMAGE_NAME is required'
                    }

                    if (!params.IMAGE_TAG?.trim()) {
                        error 'IMAGE_TAG is required'
                    }

                    if (!(params.ENVIRONMENT in ['test', 'demo', 'uat'])) {
                        error "Unsupported environment: ${params.ENVIRONMENT}"
                    }
                }
            }
        }

        stage('Notify Deployment Start') {
            steps {
                script {
                    try {
                        withCredentials([
                            string(
                                credentialsId: 'teams-webhook',
                                variable: 'TEAMS_WEBHOOK_URL'
                            )
                        ]) {
                            office365ConnectorSend(
                                webhookUrl: TEAMS_WEBHOOK_URL,
                                message: """
🟡 Docker Deployment Started

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Image: ${params.IMAGE_NAME}:${params.IMAGE_TAG}
Build: #${env.BUILD_NUMBER}
""",
                                status: 'Started',
                                adaptiveCards: true
                            )
                        }
                    } catch (Exception e) {
                        echo "WARNING: Teams notification failed: ${e.message}"
                    }
                }
            }
        }
        
        stage('Validate Ansible Configuration') {
            steps {
                sh '''
set -eu

cd /var/lib/jenkins/devops-lab/ansible

INVENTORY="inventories/${ENVIRONMENT}/hosts.yml"
VARS_FILE="vars/applications/${APP_NAME}/${ENVIRONMENT}.yml"
PLAYBOOK="playbooks/docker_app.yml"

echo "===== Validating Ansible Configuration ====="
echo "Inventory: ${INVENTORY}"
echo "Vars:      ${VARS_FILE}"
echo "Playbook:  ${PLAYBOOK}"

test -f "${INVENTORY}" || {
    echo "ERROR: Inventory not found: ${INVENTORY}"
    exit 1
}

test -f "${VARS_FILE}" || {
    echo "ERROR: Variables file not found: ${VARS_FILE}"
    exit 1
}

test -f "${PLAYBOOK}" || {
    echo "ERROR: Playbook not found: ${PLAYBOOK}"
    exit 1
}
'''
            }
        }

        stage('Validate Ansible Playbook') {
            steps {
                sh '''
set -eu

cd /var/lib/jenkins/devops-lab/ansible

ansible-playbook \
    -i "inventories/${ENVIRONMENT}/hosts.yml" \
    -e "@vars/applications/${APP_NAME}/${ENVIRONMENT}.yml" \
    -e "deployment_group=${ENVIRONMENT}" \
    -e "docker_image_repo=${IMAGE_NAME}" \
    -e "docker_image_tag=${IMAGE_TAG}" \
    playbooks/docker_app.yml \
    --syntax-check
'''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
set -eu

cd /var/lib/jenkins/devops-lab/ansible

echo "===== Deploying Application ====="
echo "Application: ${APP_NAME}"
echo "Environment: ${ENVIRONMENT}"
echo "Image: ${IMAGE_NAME}:${IMAGE_TAG}"

ansible-playbook \
    -i "inventories/${ENVIRONMENT}/hosts.yml" \
    -e "@vars/applications/${APP_NAME}/${ENVIRONMENT}.yml" \
    -e "deployment_group=${ENVIRONMENT}" \
    -e "docker_image_repo=${IMAGE_NAME}" \
    -e "docker_image_tag=${IMAGE_TAG}" \
    playbooks/docker_app.yml
'''
            }
        }
    }

    post {
        success {
            script {
                try {
                    withCredentials([
                        string(
                            credentialsId: 'teams-webhook',
                            variable: 'TEAMS_WEBHOOK_URL'
                        )
                    ]) {
                        office365ConnectorSend(
                            webhookUrl: TEAMS_WEBHOOK_URL,
                            message: """
🟢 Docker Deployment Successful

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Image: ${params.IMAGE_NAME}:${params.IMAGE_TAG}
Build: #${env.BUILD_NUMBER}
""",
                            status: 'Success',
                            adaptiveCards: true
                        )
                    }
                } catch (Exception e) {
                    echo "WARNING: Teams success notification failed: ${e.message}"
                }
            }        
        }

        failure {
            script {
                try { 
                    withCredentials([
                        string(
                            credentialsId: 'teams-alerts-webhook',
                            variable: 'TEAMS_ALERTS_WEBHOOK_URL'
                        )
                    ]) {
                        office365ConnectorSend(
                            webhookUrl: TEAMS_ALERTS_WEBHOOK_URL,
                            message: """
🔴 Docker Deployment Failed

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Image: ${params.IMAGE_NAME}:${params.IMAGE_TAG}
Build: #${env.BUILD_NUMBER}
""",
                            status: 'Failure',
                            adaptiveCards: true
                        )
                    }
                } catch (Exception e) {
                    echo "WARNING: Teams failure notification failed: ${e.message}"
                }
            }
        }
                    

        aborted {
            script {
                try {
                    withCredentials([
                        string(
                            credentialsId: 'teams-alerts-webhook',
                            variable: 'TEAMS_ALERTS_WEBHOOK_URL'
                        )
                    ]) {
                        office365ConnectorSend(
                            webhookUrl: TEAMS_ALERTS_WEBHOOK_URL,
                            message: """
⚪ Docker Deployment Aborted

Application: ${params.APP_NAME}
Environment: ${params.ENVIRONMENT}
Image: ${params.IMAGE_NAME}:${params.IMAGE_TAG}
Build: #${env.BUILD_NUMBER}
""",
                            status: 'Aborted',
                            adaptiveCards: true
                        )
                    }
                } catch (Exception e) {
                    echo "WARNING: Teams aborted notification failed: ${e.message}"
                }
            }       
        }
    }
}